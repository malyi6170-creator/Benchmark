#include <avr/pgmspace.h>

// Создаем таблицу подстановки (LUT) для синуса на 256 точек.
// Значения умножены на 100 для сохранения «дробной» точности в целых числах (fixed-point),
// а сам массив хранится во Flash-памяти (PROGMEM), экономя драгоценную RAM.
const int8_t sineTable[256] PROGMEM = {
    0,   3,   6,   9,  12,  15,  18,  22,  25,  28,  31,  34,  37,  40,  42,  45,
   48,  51,  53,  56,  58,  61,  63,  65,  68,  70,  72,  74,  76,  78,  79,  81,
   83,  84,  86,  87,  88,  90,  91,  92,  93,  94,  95,  95,  96,  97,  97,  98,
   98,  98,  98,  98,  98,  98,  97,  97,  96,  95,  95,  94,  93,  92,  91,  90,
   88,  87,  86,  84,  83,  81,  79,  78,  76,  74,  72,  70,  68,  65,  63,  61,
   58,  56,  53,  51,  48,  45,  42,  40,  37,  34,  31,  28,  25,  22,  18,  15,
   12,   9,   6,   3,   0,  -3,  -6,  -9, -12, -15, -18, -22, -25, -28, -31, -34,
  -37, -40, -42, -45, -48, -51, -53, -56, -58, -61, -63, -65, -68, -70, -72, -74,
  -76, -78, -79, -81, -83, -84, -86, -87, -88, -90, -91, -92, -93, -94, -95, -95,
  -96, -97, -97, -98, -98, -98, -98, -98, -98, -98, -97, -97, -96, -95, -95, -94,
  -93, -92, -91, -90, -88, -87, -86, -84, -83, -81, -79, -78, -76, -74, -72, -70,
  -68, -65, -63, -61, -58, -56, -53, -51, -48, -45, -42, -40, -37, -34, -31, -28,
  -25, -22, -18, -15, -12,  -9,  -6,  -3,   0,   3,   6,   9,  12,  15,  18,  22,
   25,  28,  31,  34,  37,  40,  42,  45,  48,  51,  53,  56,  58,  61,  63,  65,
   68,  70,  72,  74,  76,  78,  79,  81,  83,  84,  86,  87,  88,  90,  91,  92,
   93,  94,  95,  95,  96,  97,  97,  98,  98,  98,  98,  98,  98,  98,  97,  97
};

void setup() {
  Serial.begin(9600);
  while (!Serial);
  
  Serial.println("=== ЦЕЛОЧИСЛЕННЫЙ БЕНЧМАРК (LUT + Fixed-Point) ===");
  runFastBenchmark();
}

void loop() {
  delay(5000);
  runFastBenchmark();
}

void runFastBenchmark() {
  unsigned long startTime = micros();
  
  // Используем целочисленные переменные вместо float
  volatile int32_t accumulator = 0;
  uint8_t index = analogRead(A0) & 0xFF; // Берем младший байт шума для стартового индекса
  
  for (int i = 0; i < 10000; i++) {
    // Читаем значение синуса напрямую из Flash-памяти по указателю
    int8_t val = pgm_read_byte(&sineTable[index]);
    
    // Выполняем быстрые целочисленные операции вместо тяжелой тригонометрии
    accumulator += (val * val); 
    index += 3; // Шагаем по таблице
  }
  
  unsigned long endTime = micros();
  unsigned long duration = endTime - startTime;

  Serial.print("Итоговое целочисленное значение (для защиты от оптимизатора): ");
  Serial.println(accumulator);
  
  Serial.print("10 000 LUT-операций заняли: ");
  Serial.print(duration);
  Serial.println(" микросекунд.");
  Serial.println("----------------------------------------");
}
